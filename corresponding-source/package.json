{
  "name": "a14-pomodoro",
  "productName": "A14 Pomodoro",
  "version": "0.1.5-beta.2",
  "license": "GPL-3.0-only",
  "author": {
    "name": "abd1442"
  },
  "description": "A local-first Windows workspace for focused study, recall notes and personal study records.",
  "main": "./out/main/index.js",
  "private": true,
  "scripts": {
    "pretest": "node -e \"require('node:fs').mkdirSync('out/qa-temp',{recursive:true})\"",
    "dev": "electron-vite dev",
    "start": "electron-vite preview",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "test": "vitest run",
    "test:watch": "vitest",
    "localization:inventory": "node scripts/localization/check-copy.cjs --check",
    "localization:check": "node scripts/localization/check-copy.cjs --check --strict && node scripts/localization/advice-copy.cjs --check && node scripts/localization/learn-copy.cjs --check && node scripts/localization/learn-expansion.cjs --check",
    "build": "npm run typecheck && npm run build:foreground && electron-vite build",
    "build:qa": "node scripts/build-qa.cjs",
    "build:win": "npm run build && electron-builder --win",
    "postinstall": "node node_modules/electron/install.js && electron-builder install-app-deps",
    "build:foreground": "node scripts/build-foreground.cjs"
  },
  "dependencies": {
    "@electron-toolkit/preload": "3.0.2",
    "@electron-toolkit/utils": "4.0.0",
    "better-sqlite3": "13.0.3",
    "recharts": "3.10.1"
  },
  "devDependencies": {
    "@electron-toolkit/tsconfig": "2.0.0",
    "@tailwindcss/vite": "4.3.3",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "^24.0.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "electron": "44.7.2",
    "electron-builder": "26.15.3",
    "electron-vite": "5.0.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vite": "7.3.7",
    "vitest": "4.1.11",
    "zustand": "5.0.15"
  },
  "overrides": {
    "global-agent": "4.1.3"
  }
}
